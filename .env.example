# ResolveFlow example environment. Copy to .env and adjust. No real secrets here.
# Database (required)
DATABASE_URL=postgresql+psycopg://resolveflow:localdev@localhost:5432/resolveflow
# Optional override used by scripts/tests
TEST_DATABASE_URL=postgresql+psycopg://resolveflow:localdev@localhost:5432/resolveflow_test

# Auth (required in non-dev environments). Generate: python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET=change-me-in-non-dev
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# CORS - comma separated origins (not access control)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000,http://127.0.0.1:5173

# LLM provider: auto | deterministic | openai
# auto = openai when OPENAI_API_KEY set, else deterministic (clearly labelled test provider)
LLM_PROVIDER=auto
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_TIMEOUT_SECONDS=30
OPENAI_MAX_RETRIES=1

# Embeddings: auto | deterministic | openai
EMBEDDING_PROVIDER=auto
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIM=256

# Retrieval
RETRIEVAL_TOP_K=5
RETRIEVAL_MIN_SCORE=0.05

# Uploads
MAX_UPLOAD_BYTES=1048576

# Worker
WORKER_POLL_SECONDS=2
RUN_MAX_ATTEMPTS=3
RUN_RETRY_BACKOFF_SECONDS=5

# Seed/demo (used only by scripts/create_user.py / scripts/seed.py)
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=
SEED_AGENT_EMAIL=agent@example.com
SEED_AGENT_PASSWORD=

# Optional Slack integration (live calls untested without credentials)
SLACK_SIGNING_SECRET=
SLACK_BOT_TOKEN=
